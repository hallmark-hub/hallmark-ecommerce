# ENV: APP_ENV
APP_ENV=local

# ENV: FRONTEND_URL
FRONTEND_URL=http://localhost:5173

# ENV: BACKEND_URL
BACKEND_URL=http://localhost:8000

# ENV: CORS_ALLOWED_ORIGINS
# Comma-separated allowlist. Defaults to FRONTEND_URL if empty.
# Production: set to the exact Vercel origin only (no wildcards with credentials).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ENV: SUPABASE_URL
SUPABASE_URL=

# ENV: SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=

# ENV: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ENV: SUPABASE_JWT_SECRET
# Legacy HS256 signing secret. Leave blank when the project uses
# asymmetric (ES256) keys — tokens are then verified via the JWKS endpoint.
SUPABASE_JWT_SECRET=

# DEPRECATED — Africa's Talking was dropped; these are read by no app code.
# Customer contact now runs through WhatsApp click-to-chat on the storefront.
# Safe to delete once confirmed.
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=
# ADMIN_NOTIFICATION_PHONE=

# ENV: PAYSTACK_SECRET_KEY
PAYSTACK_SECRET_KEY=

# ENV: PAYSTACK_PUBLIC_KEY
PAYSTACK_PUBLIC_KEY=

# DEPRECATED — admin auth is a Supabase JWT with role='admin'; read by no app
# code. Safe to delete once confirmed.
# ADMIN_API_KEY=

# ENV: CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=

# ENV: CLOUDINARY_API_KEY
CLOUDINARY_API_KEY=

# ENV: CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# ENV: MAX_UPLOAD_BYTES
MAX_UPLOAD_BYTES=5000000
