# Local development
VITE_API_URL=http://localhost:8000

# Production (set in Vercel dashboard → Settings → Environment Variables)
# VITE_API_URL=https://your-backend.onrender.com

# Business contact details shown on the storefront.
# The code uses the latest client-supplied public details as fallbacks. Set these
# only when the deployed values need to be changed without a code release.

# ENV: VITE_WHATSAPP_NUMBER
# Digits only, country code first, no + or spaces. e.g. 233244123456
VITE_WHATSAPP_NUMBER=

# ENV: VITE_CONTACT_PHONE
VITE_CONTACT_PHONE=

# ENV: VITE_CONTACT_EMAIL
VITE_CONTACT_EMAIL=

# ENV: VITE_CONTACT_ADDRESS
VITE_CONTACT_ADDRESS=
